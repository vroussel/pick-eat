server {
    error_page 404             /assets/404.html;
    error_page 500 502 503 504 /assets/500.html;
    location / {
        proxy_pass http://127.0.0.1:4242;
    }

    location /_tower-livereload/event-stream {
        return 301 http://127.0.0.1:4242/_tower-livereload/event-stream;
    }

    location /assets/ {
        root /srv/www;
    }

    location ${IMAGES_URL_PREFIX} {
        root /srv/www;
    }
}
